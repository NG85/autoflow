ENVIRONMENT=production

# You can generate a new secret key by running the following command
# $ python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY is very important, please do not share it with others,
# SECRET_KEY must greater or equal to 32 characters.
SECRET_KEY=

# Replace with your own sentry dsn, leave it commented if you don't want to use sentry
# SENTRY_DSN=https://xxxx@xxx.sentry.io/xxxxxx

# Replace with your own TiDB cluster connection information,
# TiDB Serverless is recommended. You can quickly create one from https://tidbcloud.com/
TIDB_HOST=xxxxx.prod.aws.tidbcloud.com
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
TIDB_SSL=true

# JS Widgets: if you want to use JS widgets, you need to set the following variables to enable CORS.
# BACKEND_CORS_ORIGINS=https://your-domain.com

TOS_API_KEY=
TOS_API_SECRET=
TOS_API_HOST=

# Storage configuration
STORAGE_TYPE=tos
STORAGE_PATH_PREFIX=data/customer-uploads/

# TOS configuration
TOS_REGION=
TOS_ENDPOINT=
TOS_TENANT=
TOS_BUCKET=

# MinIO configuration
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=
MINIO_BUCKET=

# UFile configuration (STORAGE_TYPE=ufile)
# Example: UFILE_ENDPOINT=s3-cn-wlcb.ufileos.com  UFILE_REGION=cn-wlcb
UFILE_ENDPOINT=
UFILE_ACCESS_KEY=
UFILE_SECRET_KEY=
UFILE_BUCKET=
UFILE_REGION=

# Client Visit Guide Generation Service
ALDEBARAN_CVGG_URL=
ALDEBARAN_TENANT_ID=
# Aldebaran message queue (visit saved -> POST /messages/incoming); card via /notification/push
ALDEBARAN_MESSAGES_INCOMING_PATH=/api/v1/messages/incoming
ALDEBARAN_MESSAGE_WEBHOOK_SECRET=
ALDEBARAN_MESSAGE_SOURCE_SYSTEM=crm
ALDEBARAN_VISIT_RECORD_MESSAGE_TYPE=crm.visit_record.saved
ALDEBARAN_VISIT_RECORD_POST_PROCESS_ENABLED=true

EMBEDDING_THRESHOLD=
CRM_ENABLED=false
CRM_BILLING_ENABLED=false
CRM_BILLING_ALLOW_INSUFFICIENT_QUOTA=false

FEISHU_APP_ID=
FEISHU_APP_SECRET=